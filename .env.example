# Copy to .env.local. Do not put real passwords in this file.

NEXT_PUBLIC_SITE_URL=https://www.microvisione.com

# MySQL is the catalogue, admin, enquiry, and analytics database.
# Local building uses 127.0.0.1 port 3307. `npm run dev` inside backend/ starts that server.
# On the hosting server, use localhost and port 3306.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Optional separate API process. The Next.js app also serves /api in-process.
MICROVISION_API_URL=http://127.0.0.1:4000

# Local document storage for catalogues, manufacturer PDFs, and CVs.
MICROVISION_UPLOADS_DIR=

# Cloudinary is optional. Product photos can stay in MySQL file storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First admin is created on login when the admins table is empty.
ADMIN_USERNAME=microvision
ADMIN_EMAIL=info@microvisione.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# M-Pesa is optional. Checkout stays unpaid until these are set.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=

# --- MedTrack QR ---
# Session signing for hospital engineer/admin portal (/medtrack).
MEDTRACK_SESSION_SECRET=
# Absolute origin used in emails and QR payloads (no trailing slash).
MEDTRACK_PUBLIC_BASE_URL=http://127.0.0.1:3000
# Nodemailer SMTP for fault / maintenance tickets and client login codes.
# SMTP_HOST, SMTP_USER, and SMTP_PASS are required before a login code can be emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MedTrack QR <noreply@medtrack.local>"
